    {
      "image": "./images/kamukamu/04.png",
      "speech": "よく かんで、\nたべて ごらんなさい。"
    },
    {
      "image": "./images/kamukamu/05.png",
      "speech": "かむかむ、もぐもぐ。"
    },
    {
      "image": "./images/kamukamu/taste.png",
      "speech": "もぐもぐ、\nおいしく なった。"
    },
    {
      "image": "./images/kamukamu/08.png",
      "speech": "いっぱい、もぐもぐ。\nおなかも、いっぱい。\nうれしいね。"
